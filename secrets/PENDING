# Danh sách nợ có chủ ý: service/env chưa có SealedSecret trong repo.
#
# Mỗi dòng ở đây là một service KHÔNG chạy được nếu sync ngay bây giờ — pod sẽ
# CrashLoop vì thiếu biến môi trường. Dòng nào cũng phải biến mất trước khi bật
# service đó thật (P4 cho dev, P6 cho prod).
#
# Niêm phong một secret:
#   kubectl create secret generic <tên> -n <service>-<env> \
#     --from-literal=KEY='...' --dry-run=client -o yaml \
#   | kubeseal --format yaml > secrets/<env>/<service>/<thành-phần>.yaml
#   # rồi xoá dòng tương ứng khỏi file này
#
# CI fail cứng với mọi secret thiếu KHÔNG có tên ở đây, và với mọi lỗi khác
# (sai namespace, thiếu key, Secret thô lọt vào Git).
